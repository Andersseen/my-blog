---
import BaseHead from '@/components/BaseHead.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import SkipLink from '@/components/SkipLink.astro';
import type { ImageMetadata } from 'astro';
import type { BlogI18n } from '@/i18n/astro';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  pageType?: 'website' | 'article';
  etyma: BlogI18n;
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  pageType = 'website',
  etyma,
  noindex = false,
} = Astro.props;
---

<style>
  .app-backdrop {
    background:
      radial-gradient(
        circle at top,
        hsl(var(--backdrop-top) / 0.34) 0%,
        transparent 64%
      ),
      radial-gradient(
        circle at bottom,
        hsl(var(--backdrop-bottom) / 0.24) 0%,
        transparent 60%
      );
  }
</style>

<!doctype html>
<html lang={etyma.locale} dir={etyma.direction} data-theme="light">
  <head>
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme-cache');
          var scheme = t === 'dark' || t === 'light' ? t :
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', scheme);
          document.documentElement.style.colorScheme = scheme;
          window.__AND_ANIMATED__ = true;
        } catch (e) {}
      })();
    </script>
    <BaseHead title={title} description={description} image={image} pageType={pageType} etyma={etyma} noindex={noindex} />

  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <SkipLink t={etyma.t} />
    <div class="relative min-h-screen">
      <div
        aria-hidden="true"
        class="app-backdrop pointer-events-none absolute inset-0 -z-10"
      ></div>

      <div class="mx-auto flex min-h-screen w-full max-w-7xl flex-col px-4 sm:px-6 md:px-8 lg:px-8">
        <Header etyma={etyma} />
        <main id="main-content" class="flex-1 pb-8 pt-2" tabindex="-1">
          <slot />
        </main>
        <Footer t={etyma.t} />
      </div>
    </div>

    <script>
      import '@/scripts/setup-andersseen';
      import { initTheme } from '@/store/theme';

      void initTheme();
    </script>
  </body>
</html>
