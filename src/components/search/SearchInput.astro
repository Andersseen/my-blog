---
import type { Dictionary } from '../../i18n';

interface Props {
  messages: Dictionary;
}

const { messages } = Astro.props;
---

<div class="relative" data-pagefind-search>
  <label for="search-input" class="sr-only">{messages.nav.search}</label>
  <div class="relative">
    <and-icon
      name="search"
      size="16"
      class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground"
      aria-hidden="true"></and-icon>
    <input
      id="search-input"
      type="search"
      placeholder={messages.nav.searchPlaceholder}
      class="w-full rounded-full border border-primary-300 bg-surface-strong py-2 pl-10 pr-4 text-sm text-foreground placeholder:text-muted-foreground focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20"
      data-pagefind-ui
    />
  </div>
</div>

<script>
  async function loadPagefindScript(): Promise<Pagefind | undefined> {
    return new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = '/pagefind/pagefind.js';
      script.onload = () => resolve(window.pagefind);
      script.onerror = reject;
      document.head.appendChild(script);
    });
  }

  async function initPagefind() {
    const searchInput = document.querySelector<HTMLInputElement>('[data-pagefind-ui]');
    if (!searchInput || typeof window === 'undefined') return;

    searchInput.addEventListener(
      'focus',
      async () => {
        if (window.__pagefindLoaded) return;
        try {
          const pagefind = await loadPagefindScript();
          if (!pagefind) {
            console.warn('Pagefind not available');
            return;
          }
          await pagefind.init();
          window.__pagefindLoaded = true;

          searchInput.addEventListener('input', async event => {
            const target = event.target;
            if (!(target instanceof HTMLInputElement)) return;

            const query = target.value;
            if (query.length < 2) return;

            const results = await pagefind.search(query);
            console.log('Pagefind results:', results);
          });
        } catch (err) {
          console.warn('Pagefind not available:', err);
        }
      },
      { once: true },
    );
  }

  void initPagefind();
</script>
