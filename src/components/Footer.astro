---
import { AUTHOR_MEDIUM_URL, AUTHOR_NAME, AUTHOR_PORTFOLIO_URL } from '../consts';
import type { Translate } from '../i18n/astro';

interface Props {
	t: Translate;
}

const { t } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-primary-200 py-8 text-sm text-foreground/70">
	<div class="flex flex-col items-center justify-between gap-3 sm:flex-row">
		<p>{t('footer.rights', { year, author: AUTHOR_NAME })}</p>
		<p class="flex items-center gap-3 text-foreground/60">
			<and-button href={AUTHOR_PORTFOLIO_URL} target="_blank" rel="me noopener noreferrer" variant="link" size="sm" custom-class="p-0 h-auto">
				{t('footer.portfolio')}
				<and-icon slot="end" name="external-link" size="13" aria-hidden="true"></and-icon>
			</and-button>
			<span aria-hidden="true">•</span>
			<and-button href={AUTHOR_MEDIUM_URL} target="_blank" rel="me noopener noreferrer" variant="link" size="sm" custom-class="p-0 h-auto">
				{t('footer.medium')}
				<and-icon slot="end" name="external-link" size="13" aria-hidden="true"></and-icon>
			</and-button>
		</p>
	</div>
</footer>
