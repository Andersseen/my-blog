---
interface Props {
	date: Date;
	locale?: string;
}

const { date, locale = 'en' } = Astro.props;

// BCP-47 language codes only (e.g. "uk", never the "ua" URL path) — Intl maps
// the bare language subtag to a sensible region on its own.
const localeMap: Record<string, string> = {
	es: 'es-ES',
	en: 'en-US',
	uk: 'uk-UA',
};

const resolvedLocale = localeMap[locale] || locale;
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString(resolvedLocale, {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		})
	}
</time>
