---
const iconVersion = '2026-09-17';
---

<link rel="icon" href={`/favicon.svg?v=${iconVersion}`} type="image/svg+xml" sizes="any" />
<link rel="icon" href={`/favicon.ico?v=${iconVersion}`} sizes="any" />
<link rel="icon" href={`/icon-192.png?v=${iconVersion}`} type="image/png" sizes="192x192" />
<link rel="icon" href={`/icon-512.png?v=${iconVersion}`} type="image/png" sizes="512x512" />
<link rel="apple-touch-icon" href={`/apple-touch-icon.png?v=${iconVersion}`} sizes="180x180" />
<link rel="manifest" href={`/site.webmanifest?v=${iconVersion}`} />
<link rel="mask-icon" href={`/favicon.svg?v=${iconVersion}`} color="#6366f1" />
