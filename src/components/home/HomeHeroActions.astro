---
import type { BlogI18n } from '../../i18n/astro';

interface Props {
  etyma: BlogI18n;
}

const { etyma } = Astro.props;
---

<div class="flex flex-wrap items-center gap-3 pt-2">
  <and-button
    href={etyma.path('/blog/')}
    variant="default"
    size="sm"
    custom-class="rounded-full px-5"
  >
    {etyma.t('nav.blog')}
  </and-button>
</div>
