---
import type { BlogI18n, MessageKey } from '../../i18n';

interface Props {
  etyma: BlogI18n;
  class?: string;
  slot?: string;
}

const { etyma, class: className, slot: slotName } = Astro.props;

// Locale codes are only known at runtime, but this map keeps every value a
// real, typo-checked catalog key — `t()` itself stays fully typed.
const LANGUAGE_LABEL_KEY: Record<string, MessageKey> = {
  es: 'language.es',
  en: 'language.en',
  uk: 'language.uk',
};

// `etyma.path()` takes an already-bare logical path (e.g. "/blog"), not the
// current, already-locale-prefixed `Astro.url.pathname` (it throws on that).
// `seo().alternates` is built from the same bare path internally, so it's
// reused here to link "this page in another locale" instead of re-deriving it.
//
// This is also a static build: there is no request to read a query string or
// fragment from at prerender time, only the route's own path. The current
// visitor's live `?query#hash` is appended client-side, in this component's
// own <script>, at the moment they actually switch language.
const alternates = etyma.seo().alternates;

const languageItems = alternates
  .filter((alternate) => alternate.hreflang !== etyma.locale)
  .map((alternate) => ({
    text: etyma.t(LANGUAGE_LABEL_KEY[alternate.hreflang]),
    value: new URL(alternate.href).pathname,
  }));

const activeLabel = etyma.t(LANGUAGE_LABEL_KEY[etyma.locale]);
---

<style>
  .language-dropdown {
    --background: var(--surface-strong);
    --foreground: var(--foreground);
    --primary: var(--primary-600);
    --primary-foreground: 0 0% 100%;
    --secondary: var(--surface-container-high);
    --secondary-foreground: var(--foreground);
    --popover: var(--surface-strong);
    --popover-foreground: var(--foreground);
    --border: var(--primary-300);
    --input: var(--primary-300);
    --ring: var(--primary-500);
    --accent: var(--primary-100);
    --accent-foreground: var(--primary-900);
  }
</style>

<and-dropdown
  slot={slotName}
  class:list={['language-dropdown w-auto min-w-[84px] sm:min-w-[88px]', className]}
  label={`${etyma.t('language.label')}: ${activeLabel}`}
  data-language-dropdown
  data-language-items={JSON.stringify(languageItems)}
  aria-label={etyma.t('language.label')}
>
  <and-button
    slot="trigger"
    type="button"
    variant="outline"
    size="default"
    data-language-trigger
    aria-expanded="false"
    aria-haspopup="menu"
    custom-class="h-10 w-full text-xs uppercase tracking-wide"
  >
    <and-icon slot="start" name="compass" size="14" aria-hidden="true"></and-icon>
    {activeLabel}
    <svg slot="end" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
  </and-button>
</and-dropdown>

<script>
  type DropdownItem = {
    text: string;
    value: string;
    disabled?: boolean;
  };

  type AndDropdownElement = HTMLElement & {
    items: DropdownItem[];
  };

  const updateTriggerExpanded = (dropdown: HTMLElement, isOpen: boolean) => {
    const trigger = dropdown.querySelector<HTMLElement>('[data-language-trigger]');

    if (!trigger) {
      return;
    }

    trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  };

  const parseItems = (rawItems: string | null): DropdownItem[] => {
    if (!rawItems) {
      return [];
    }

    try {
      const parsed = JSON.parse(rawItems) as DropdownItem[];
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  };

  const mountLanguageDropdowns = async () => {
    if (typeof customElements !== 'undefined') {
      await customElements.whenDefined('and-dropdown');
    }

    const dropdowns = document.querySelectorAll<AndDropdownElement>('[data-language-dropdown]');

    dropdowns.forEach((dropdown) => {
      if (dropdown.dataset.bound === 'true') {
        return;
      }

      dropdown.dataset.bound = 'true';
      dropdown.items = parseItems(dropdown.getAttribute('data-language-items'));

      updateTriggerExpanded(dropdown, false);

      dropdown.addEventListener('andDropdownOpenChange', (event: Event) => {
        const isOpen = (event as CustomEvent<boolean>).detail;
        updateTriggerExpanded(dropdown, Boolean(isOpen));
      });

      dropdown.addEventListener('andDropdownSelect', (event: Event) => {
        const selection = (event as CustomEvent<string>).detail;

        if (typeof selection !== 'string' || selection.length === 0) {
          return;
        }

        // `selection` is the statically prerendered target path only — a static
        // build has no request to read a query string or fragment from, so the
        // *current* visitor's `?query#hash` (which only exists client-side) is
        // appended here, at the moment they actually switch language.
        const [targetPath] = selection.split(/[?#]/);
        const destination = `${targetPath}${window.location.search}${window.location.hash}`;

        window.location.assign(destination);
      });
    });
  };

  void mountLanguageDropdowns();
</script>