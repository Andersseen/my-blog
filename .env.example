# Site Configuration
SITE_URL=https://andersseen.dev

# External Content Sources
MEDIUM_RSS_URL=https://medium.com/feed/@andriipap

# Build Configuration
# NODE_ENV=production

# Optional: Analytics (Umami — self-hosted)
# PUBLIC_UMAMI_URL=https://umami.andersseen.dev/script.js
# PUBLIC_UMAMI_WEBSITE_ID=your_website_uuid

# Optional: Cloudflare
# CLOUDFLARE_ACCOUNT_ID=your_account_id
# CLOUDFLARE_API_TOKEN=your_api_token

# Glossa (translations). Only the NAME is documented; the value lives in your shell/secret store, never here.
# Needed only for agent/MCP translation edits (see AGENTS.md). Builds and the deployed site do not use it.
# GLOSSA_TOKEN=
